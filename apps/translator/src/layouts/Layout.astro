---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuraBackground from "../components/AuraBackground.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Traductor</title>
    <Font cssVariable="--geist-sans" />
  </head>
  <body>
    <AuraBackground>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </AuraBackground>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: #100e0b;
    color: #d4d4d8;
    font-family: var(--geist-sans);

    main {
      height: 100%;
      width: 100%;
      flex: 1;

      section {
        padding: 1rem;
      }
    }
  }
</style>
